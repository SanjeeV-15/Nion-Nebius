# Copy this file to .env and fill in your own values. Never put a real key in this file.

# Which AI answers: "claude" (default) or "nebius" (a model on Nebius Token Factory).
NION_PROVIDER=claude

# Used when NION_PROVIDER=claude
ANTHROPIC_API_KEY=

# Used when NION_PROVIDER=nebius. NION_MODEL must be a model name from Token Factory's model list.
NEBIUS_API_KEY=
# NION_MODEL=

# Web search for the nebius provider (Tavily). Optional: without it Nion says it can't look things up.
TAVILY_API_KEY=
