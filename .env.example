# Copy this file to .env and fill in your own values. Never put a real key in this file.

# Your Nebius Token Factory key (required).
NEBIUS_API_KEY=

# Web search through Tavily (optional: without it Nion says it can't look things up).
TAVILY_API_KEY=

# The model to use. Default: nvidia/Nemotron-3-Ultra-550b-a55b
# NION_MODEL=

# When the main model is slow or overloaded: "same" tries it once more (default), "none" gives up,
# or name another model. In testing the small Nano model was slower than Ultra on search questions.
# NION_FALLBACK_MODEL=

# Fair use for a public demo (all optional). 0 turns a limit off.
# NION_DAILY_CAP=3000          questions per day for the whole demo: the real protection for your credit
# NION_RATE_PER_HOUR=200       per visitor (each browser makes up its own id)
# NION_IP_RATE_PER_HOUR=1000   per network address: a backstop against scripts
# NION_TRUST_PROXY=1           how many proxies sit in front of Nion on the host
